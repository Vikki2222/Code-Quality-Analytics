# Copy to .env (docker compose) and/or backend/.env (npm run dev).
# Never commit real values. Use different secrets for each environment.

# --- Server ---------------------------------------------------------------
NODE_ENV=development
PORT=4000
LOG_LEVEL=info
# Public URL of the frontend (used for CORS and OAuth redirects)
FRONTEND_URL=http://localhost
# Reverse proxies in front of Express: 1 locally (nginx), 2 on Coolify (Traefik + nginx)
TRUST_PROXY_HOPS=1

# --- Secrets (generate fresh per environment) -----------------------------
# openssl rand -hex 32   (min 32 chars)
SESSION_SECRET=
# openssl rand -hex 32   (must be exactly 64 hex chars). Rotating it logs every user out.
TOKEN_ENCRYPTION_KEY=

# --- Data stores ----------------------------------------------------------
# For npm run dev; docker compose builds these from the service names.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/code_quality_analytics
REDIS_URL=redis://localhost:6379
# docker compose only. Applied when the volume is first created; URL-safe value (openssl rand -hex 24)
POSTGRES_PASSWORD=

# --- GitHub OAuth app -----------------------------------------------------
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Must match the OAuth app's callback URL exactly
GITHUB_CALLBACK_URL=http://localhost/api/auth/github/callback

# --- GitHub webhook -------------------------------------------------------
# Same value as the webhook's "Secret" in repo settings (content type: application/json)
GITHUB_WEBHOOK_SECRET=

# --- AI providers ---------------------------------------------------------
# PR analysis (OpenRouter)
OPENROUTER_API_KEY=
# Embeddings for fingerprint matching (Gemini)
GEMINI_API_KEY=
